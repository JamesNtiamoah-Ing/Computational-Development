##1
FLOWSHEET ;##1
    BLOCK MIXER IN=RW FD OUT=8
    BLOCK SEP IN=2 OUT=TP RW
    BLOCK E-CELL IN=8 OUT=2 PI
    BLOCK B1 IN=S1 TP OUT=S2
    BLOCK B2 IN=S2 OUT=S20 S12 S11
    BLOCK B3 IN=S4 OUT=S5 S9
    BLOCK B4 IN=S5 OUT=S6 S8 S7 S10
    BLOCK B5 IN=S8 OUT=S3 S13 S18 S15
    BLOCK B6 IN=S3 S6 OUT=S14
    BLOCK B7 IN=S14 OUT=S16 1
    BLOCK B8 IN=S19 S20 OUT=S4
    BLOCK B9 IN=1 OUT=S19
DEF-STREAMS HEAT PI ;##2
DEF-STREAMS HEAT S9 ;##3
DEF-STREAMS HEAT S10 ;##4
DEF-STREAMS HEAT S11 ;##5
DEF-STREAMS HEAT S15 ;##6
DEF-STREAMS HEAT S18 ;##7
BLOCK B5 RADFRAC ;##1
    PARAM NSTAGE=10 ALGORITHM=STANDARD MAXOL=25 NPHASE=2  &
        DAMPING=NONE
    COL-CONFIG CONDENSER=PARTIAL-V
    FEEDS S8 4
    PRODUCTS S3 1 V / S13 10 L
    PRODUCTS S15 10 / S18 1
    P-SPEC 1 1.000000000
    COL-SPECS MASS-D=0.12 MASS-RR=1.2
    BLOCK-OPTION FREE-WATER=YES
##2
